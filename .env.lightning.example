# Lightning AI Studio
# Store secrets in Lightning AI User/Teamspace Secrets, not in this file.

# Required persistent secrets:
# JWT_SECRET=
# API_KEY_SECRET=
# STORAGE_ENCRYPTION_KEY=
# OMNIROUTE_API_KEY=

# Persistent Studio storage (launcher default):
DATA_DIR=~/.omniroute

# Fixed OmniRoute port:
PORT=20128
APP_BIND_HOST=0.0.0.0
OMNIROUTE_SERVER_HOST=0.0.0.0
REQUIRE_API_KEY=true

# Optional: set this only if you have a stable public URL for the exposed port.
# NEXT_PUBLIC_BASE_URL=https://your-fixed-public-url
