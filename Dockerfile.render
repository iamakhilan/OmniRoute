# Render-specific image: combine OmniRoute's backend-only build path with a
# minimal security profile. This keeps the API/runtime while avoiding the heavy
# dashboard compilation that exceeds Render's 8 GB build pipeline.

FROM node:26-trixie-slim AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV OMNIROUTE_USE_TURBOPACK=0
ENV OMNIROUTE_BUILD_MEMORY_MB=5120
ENV NODE_OPTIONS=--max-old-space-size=5120
ENV CIRCLE_NODE_TOTAL=2
ENV OMNIROUTE_BUILD_PROFILE=minimal
ENV OMNIROUTE_MITM_STUB=1
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ libsecret-1-0 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY open-sse/package.json ./open-sse/package.json
COPY scripts/build/postinstall.mjs ./scripts/build/postinstall.mjs
COPY scripts/build/postinstallSupport.mjs ./scripts/build/postinstallSupport.mjs
COPY scripts/build/native-binary-compat.mjs ./scripts/build/native-binary-compat.mjs

RUN test -f package-lock.json \
  || (echo "package-lock.json is required for reproducible Docker builds" >&2 && exit 1)

RUN npm ci --include=optional --no-audit --no-fund --legacy-peer-deps --ignore-scripts \
  && (cd node_modules/better-sqlite3 \
      && node /usr/local/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js rebuild) \
  && node -e "require('better-sqlite3')(':memory:').close()"

COPY . ./

# build:backend enables OMNIROUTE_BUILD_BACKEND_ONLY=1. Together with the
# minimal profile this stubs dashboard pages and removes optional privileged
# modules during compilation, while still producing a standalone server bundle.
RUN npm run build:backend

FROM node:26-trixie-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=20128
ENV HOSTNAME=0.0.0.0
ENV DATA_DIR=/app/data
ENV OMNIROUTE_MIGRATIONS_DIR=/app/migrations
ENV OMNIROUTE_MEMORY_MB=6144
ENV NODE_OPTIONS=--max-old-space-size=6144

RUN apt-get update \
  && apt-get install -y --no-install-recommends libsecret-1-0 ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /app/data

COPY --from=builder /app/.build/next/standalone ./
COPY --from=builder /app/node_modules/better-sqlite3 ./node_modules/better-sqlite3
COPY --from=builder /app/scripts/dev/healthcheck.mjs ./healthcheck.mjs
COPY --from=builder /app/scripts/check-permissions.sh ./check-permissions.sh

RUN chmod +x ./check-permissions.sh

RUN chown -R node:node /app
USER node

EXPOSE 20128

ENTRYPOINT ["/app/check-permissions.sh"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["node", "healthcheck.mjs"]
CMD ["node", "dev/run-standalone.mjs"]
